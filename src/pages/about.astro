---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "À propos de moi";

const identity = {
  firstName: "Stéphane KINYOK",
  country: "France",
  city: "Angers",
  occupation: "Étudiant ingénieur en informatique et électronique",
  hobbies: ["lecture", "nouvelles technologies", "voyages", "course", "football"],
};

const skills = [
  "Python, Java, C, R et SQL",
  "HTML, CSS, JavaScript, PHP, Django et Astro",
  "Pandas, Power BI, Tableau, Talend, ETL, Machine Learning et NLP",
  "MySQL, Oracle, MariaDB et phpMyAdmin",
  "Linux, Cisco Packet Tracer, Microsoft Azure, Git et GitHub",
];

const qualities = [
  "Rigueur et organisation",
  "Esprit d’équipe",
  "Autonomie",
  "Méthodes agiles",
  "Communication efficace",
  "Adaptabilité et curiosité",
];

const passionateAboutTech = true;
const engineeringDegreeCompleted = false;
const graduationYear = 2027;

// Ces variables restent un exemple de style dynamique avec Astro.
const skillColor = "var(--color-primary, #2457d6)";
const fontWeight = "700";
const textCase = "none";
---

<BaseLayout pageTitle={pageTitle}>
  <div class="about-page container">
    <section class="about-intro" aria-labelledby="about-intro-title">
      <div data-reveal="left">
        <p class="eyebrow">Profil · Informatique · Data</p>
        <h2 id="about-intro-title">
          Je transforme des besoins techniques en solutions utiles et fiables.
        </h2>
      </div>

      <div class="about-intro__copy" data-reveal="right">
        <p>
          Je m’appelle {identity.firstName}. Basé à {identity.city}, je suis {identity.occupation.toLowerCase()}.
          Je développe mes compétences à la rencontre du logiciel, des systèmes d’information et de la donnée.
        </p>
        {passionateAboutTech && (
          <p>
            Je suis particulièrement attiré par l’analyse de données, les infrastructures, la cybersécurité
            et la création d’applications web.
          </p>
        )}
      </div>
    </section>

    <section class="about-grid" aria-label="Parcours et compétences">
      <article class="panel panel--accent" data-reveal="left">
        <p class="eyebrow">En quelques mots</p>
        <h2>Un profil polyvalent</h2>
        <p>
          Mon parcours associe une formation scientifique exigeante à des expériences concrètes en analyse
          de données, développement web, bases de données et gestion de projet.
        </p>
        <dl class="profile-facts">
          <div>
            <dt>Localisation</dt>
            <dd>{identity.city}, {identity.country}</dd>
          </div>
          <div>
            <dt>Formation actuelle</dt>
            <dd>Cycle ingénieur à l’ESEO</dd>
          </div>
          <div>
            <dt>Diplôme visé</dt>
            <dd>{graduationYear}</dd>
          </div>
        </dl>
        {!engineeringDegreeCompleted && (
          <p class="status-note">Formation d’ingénieur en cours, diplomation prévue en {graduationYear}.</p>
        )}
      </article>

      <article class="panel" data-reveal="right">
        <p class="eyebrow">Compétences techniques</p>
        <h2>Ma boîte à outils</h2>
        <ul class="skill-list">
          {skills.map((skill) => <li class="skill">{skill}</li>)}
        </ul>
      </article>
    </section>

    <section class="about-section" aria-labelledby="experience-title">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">Expérience sélectionnée</p>
        <h2 id="experience-title">Data Analyst Junior · Groupe KIM</h2>
        <p>Yaoundé · juillet à août 2024</p>
      </div>

      <div class="timeline">
        <article class="timeline__item panel" data-reveal>
          <span class="timeline__marker" aria-hidden="true"></span>
          <h3>Données à grande échelle</h3>
          <p>Extraction et transformation de plus de 500 000 lignes MySQL avec Python et Pandas.</p>
        </article>
        <article class="timeline__item panel" data-reveal>
          <span class="timeline__marker" aria-hidden="true"></span>
          <h3>Décision par la donnée</h3>
          <p>Création de trois tableaux de bord dynamiques sous Power BI pour faciliter l’analyse métier.</p>
        </article>
        <article class="timeline__item panel" data-reveal>
          <span class="timeline__marker" aria-hidden="true"></span>
          <h3>Automatisation</h3>
          <p>
            Automatisation de rapports avec Excel et Power Query, réduisant le temps d’analyse de 30 %,
            ainsi qu’une expérimentation NLP pour résumer des comptes rendus.
          </p>
        </article>
      </div>
    </section>

    <section class="about-grid" aria-label="Projets et formation">
      <article class="panel" data-reveal="left">
        <p class="eyebrow">Projet technique</p>
        <h2>Infrastructure, réseau et base de données</h2>
        <p>
          Conception d’une infrastructure avec Cisco Packet Tracer, déploiement d’une machine virtuelle
          Linux sur Microsoft Azure et sécurisation de sites web par SSL.
        </p>
        <p>
          Mise en place d’une base MariaDB, administration avec phpMyAdmin et MySQL Workbench, puis
          interrogation des données avec des requêtes SQL avancées.
        </p>
      </article>

      <article class="panel panel--soft" data-reveal="right">
        <p class="eyebrow">Formation</p>
        <h2>Un parcours scientifique et technique</h2>
        <ol class="education-list">
          <li>
            <strong>ESEO, Angers</strong>
            <span>Diplôme d’ingénieur informatique et électronique · 2024–{graduationYear}</span>
          </li>
          <li>
            <strong>Prépas Internationales, Yaoundé</strong>
            <span>Classe préparatoire MPSI · 2022–2024</span>
          </li>
          <li>
            <strong>Lycée Général Leclerc, Yaoundé</strong>
            <span>Baccalauréat C · 2022</span>
          </li>
        </ol>
      </article>
    </section>

    <section class="panel about-qualities" aria-labelledby="qualities-title" data-reveal>
      <div>
        <p class="eyebrow">Ma façon de travailler</p>
        <h2 id="qualities-title">Curieux, structuré et orienté collectif</h2>
        <p>
          J’aime comprendre un problème dans son ensemble, apprendre rapidement et partager une solution
          claire avec l’équipe.
        </p>
      </div>
      <ul class="tag-list" aria-label="Qualités professionnelles">
        {qualities.map((quality) => <li>{quality}</li>)}
      </ul>
    </section>

    <section class="about-interests" aria-labelledby="interests-title" data-reveal>
      <p class="eyebrow">Au-delà du code</p>
      <h2 id="interests-title">Ce qui nourrit ma curiosité</h2>
      <p>
        Parmi mes centres d’intérêt : {identity.hobbies.slice(0, -1).join(", ")} et {identity.hobbies.at(-1)}.
      </p>
    </section>
  </div>

  <style define:vars={{ skillColor, fontWeight, textCase }}>
    .skill {
      color: var(--skillColor);
      font-weight: var(--fontWeight);
      text-transform: var(--textCase);
    }
  </style>
</BaseLayout>
