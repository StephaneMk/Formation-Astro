---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Le blog informatique de Stéphane";
---

<BaseLayout pageTitle={pageTitle}>
		<h2>Bienvenue sur mon blog !</h2>

		<p>
			Je suis étudiant ingénieur en informatique et électronique. Sur ce blog,
			je partage ce que j’apprends ainsi que mes expériences et mes projets.
		</p>

		<h2>Développement web</h2>

		<p>
			Je présenterai mes apprentissages en HTML, CSS, JavaScript, PHP, Django
			et Astro, ainsi que la création de mes sites web.
		</p>

		<h2>Data et intelligence artificielle</h2>

		<p>
			Je parlerai de Python, SQL, Pandas, Power BI, Machine Learning et NLP à
			travers des exemples et des projets d’analyse de données.
		</p>

		<h2>Systèmes, réseaux et cybersécurité</h2>

		<p>
			Je partagerai également mes découvertes sur Linux, Microsoft Azure, les
			réseaux, les bases de données et la sécurisation des applications web.
		</p>
		<ul>
			<li><a href="/posts/post-1/">Article 1</a></li>
			<li><a href="/posts/post-2/">Article 2</a></li>
			<li><a href="/posts/post-3/">Article 3</a></li>
		</ul>
</BaseLayout>
