---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';
import Greeting from '../components/Greeting.jsx';

const pageTitle = 'Stéphane KINYOK | Ingénierie informatique';
const featuredPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  pageTitle={pageTitle}
  description="Portfolio de Stéphane KINYOK : data, développement web, systèmes d’information, réseaux et cybersécurité."
  showPageTitle={false}
  pageClass="home-page"
>
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Portfolio · Ingénierie informatique</p>
        <h1>
          Concevoir des solutions numériques
          <span>utiles, fiables et lisibles.</span>
        </h1>
        <p class="hero-lead">
          Je suis Stéphane KINYOK, étudiant ingénieur en informatique et
          électronique à l’ESEO. Je transforme les données, les systèmes et les
          idées en projets concrets.
        </p>

        <div class="button-row">
          <a class="button button--primary" href="#projets">Découvrir mes projets</a>
          <a class="button button--secondary" href="/about/">Voir mon parcours</a>
        </div>

        <ul class="hero-stats" aria-label="Quelques repères de mon parcours">
          <li><strong>500 000+</strong><span>lignes de données traitées</span></li>
          <li><strong>3</strong><span>tableaux de bord Power BI</span></li>
          <li><strong>2027</strong><span>diplôme d’ingénieur visé</span></li>
        </ul>
      </div>

      <figure class="hero-visual">
        <div class="hero-image-frame">
          <img
            src="/images/hero-ingenierie-informatique.jpg"
            alt="Poste de travail réel d’ingénierie informatique avec deux écrans, dont un affichant du code."
            width="4288"
            height="2848"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption>
          Photographie réelle 4K de Farzad Nazifi —
          <a href="https://commons.wikimedia.org/wiki/File:Coding_workstation_(Unsplash).jpg" target="_blank" rel="noreferrer">CC0</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section container" aria-labelledby="expertises-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Mes domaines</p>
        <h2 id="expertises-title">Une approche complète de l’informatique</h2>
      </div>
      <p>
        De la donnée jusqu’au déploiement, je développe une vision transversale
        des systèmes d’information.
      </p>
    </div>

    <div class="expertise-grid">
      <article class="expertise-card expertise-card--blue">
        <span class="card-number">01</span>
        <h3>Data & intelligence artificielle</h3>
        <p>Python, Pandas, SQL, Power BI, Machine Learning et NLP.</p>
      </article>
      <article class="expertise-card expertise-card--pink">
        <span class="card-number">02</span>
        <h3>Systèmes, réseaux & cloud</h3>
        <p>Linux, Cisco, Microsoft Azure, MySQL et sécurisation web.</p>
      </article>
      <article class="expertise-card expertise-card--light">
        <span class="card-number">03</span>
        <h3>Développement logiciel & web</h3>
        <p>Java, C, JavaScript, PHP, Django, Astro, Git et GitHub.</p>
      </article>
    </div>
  </section>

  <section id="projets" class="section projects-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Sélection</p>
          <h2>Projets et expériences</h2>
        </div>
        <a class="text-link" href="/blog/">Voir tous les articles <span aria-hidden="true">→</span></a>
      </div>

      <ul class="post-grid" role="list">
        {featuredPosts.map((post) => (
          <BlogPost
            url={`/posts/${post.id}/`}
            title={post.data.title}
            description={post.data.description}
            image={post.data.image}
            logo={post.data.logo}
            tags={post.data.tags}
            pubDate={post.data.pubDate}
          />
        ))}
      </ul>
    </div>
  </section>

  <section class="section container split-callout">
    <div>
      <p class="eyebrow">Un site vivant</p>
      <h2>Bienvenue dans mon espace numérique</h2>
      <p>
        Le bouton ci-dessous est un composant Preact hydraté : il montre comment
        Astro ajoute de l’interactivité seulement là où elle est utile.
      </p>
    </div>
    <div class="interactive-card">
      <Greeting
        client:load
        messages={["Salut", "Bonjour", "Bienvenue", "Coucou"]}
      />
    </div>
  </section>

  <section class="contact-banner">
    <div class="container contact-banner__inner">
      <div>
        <p class="eyebrow">Construisons la suite</p>
        <h2>Une idée, un projet ou simplement envie d’échanger ?</h2>
      </div>
      <a class="button button--light" href="mailto:stephanekinyok26@gmail.com">Me contacter</a>
    </div>
  </section>
</BaseLayout>
