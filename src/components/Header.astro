---
import Menu from './Menu.astro';
import Navigation from './Navigation.astro';
import ThemeIcon from './ThemeIcon.astro';
---

<header class="site-header">
  <div class="scroll-progress" aria-hidden="true">
    <span id="scroll-progress-bar"></span>
  </div>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Accueil — Portfolio de Stéphane KINYOK">
      <span class="brand-mark" aria-hidden="true">SK</span>
      <span class="brand-copy">
        <strong>Stéphane KINYOK</strong>
        <small>Ingénierie informatique</small>
      </span>
    </a>

    <div class="header-actions">
      <Menu />
      <Navigation />
      <ThemeIcon />
    </div>
  </div>
</header>
