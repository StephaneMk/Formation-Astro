---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
const external = href.startsWith('http');
---

<a
  class="social-link"
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noreferrer' : undefined}
>
  {label}
  {external && <span class="sr-only"> (nouvel onglet)</span>}
</a>
